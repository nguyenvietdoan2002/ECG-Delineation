.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Experiment artefacts live in the Modal Volume; only predictions and result JSONs are committed.
*.pt
*.safetensors
*.npy
*.npz
# Class maps of the development models are small raw predictions, committed so the M3 report is reproducible.
!results/m3/*_classes.npz
# The deck figure cache: a 5-component projection of one record's states, so the figure needs no 183 MB download.
!results/deck/*.npz
# Local exchange files (e.g. the MATLAB input and output of scripts/ecgdeli_ludb.py); never committed.
work/
# Local data (LUDB under data/ludb); never committed.
data/
# Kept private until the paper is submitted.
docs/paper.md
docs/refs/
